# Phishing Shield AI - Environment Configuration Example
# Copy to .env for local development

# Google Cloud / Web Risk API Key (Optional - for direct or backend reputation queries)
VITE_GOOGLE_WEB_RISK_API_KEY=YOUR_WEB_RISK_API_KEY_HERE

# Google Gemini API Key (Optional - for cloud AI fallback on ambiguous scores)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Backend Proxy URL (For production deployments keeping secrets off client)
VITE_BACKEND_PROXY_URL=http://localhost:8080

# Firebase Configuration (Optional - for community threat reporting)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=phishing-shield-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=phishing-shield-ai
VITE_FIREBASE_STORAGE_BUCKET=phishing-shield-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
