    GEMINI["Google Gemini Cloud API\n(1.5 Flash)"]
    BACKEND["Cloud Run Proxy Backend\n(/api/webrisk, /api/gemini)"]
    FIREBASE["Firebase Firestore\n(Community Reports)"]
  end

  StageB -.->|"Sanitized URL Query"| GWR
  StageB -.->|"Proxy Query"| BACKEND
  StageD -.->|"PII-Redacted Excerpt"| GEMINI
  StageD -.->|"Proxy Request"| BACKEND
  Popup -.->|"Report Phishing Domain"| FIREBASE
