rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Community phishing reports collection
    match /community_reports/{reportId} {
      // Allow reading aggregated reports
      allow read: if true;

      // Allow creating a report only if authenticated (including anonymous auth)
      // and payload satisfies strict validation rules
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['domain', 'timestamp', 'verdict', 'reporterUid'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.domain is string
        && request.resource.data.domain.size() <= 100
        // Enforce that report timestamp is fresh
        && request.resource.data.timestamp >= request.time - duration.value(5, 'm')
        // Disallow storing raw URL queries or PII
        && !request.resource.data.keys().hasAny(['password', 'emailBody', 'token', 'rawUrlWithQuery']);

      // Disallow updating or deleting reports from client
      allow update, delete: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
